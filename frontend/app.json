{
  "expo": {
    "name": "BikeFriends",
    "slug": "bikefriends",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bikefriends",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.ridetogetherapp.q1dnkf",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Track your ride route and speed live.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Keep tracking your ride while phone is locked.",
        "NSMicrophoneUsageDescription": "Talk to friends over the group ride intercom.",
        "NSBluetoothAlwaysUsageDescription": "Route intercom audio to your Bluetooth helmet.",
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D0E11"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.ridetogetherapp.q1dnkf",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECORD_AUDIO",
        "BLUETOOTH_CONNECT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF6B00"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0E11"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f487d0a7-5d36-4cc1-97ec-d393c0d51a74"
      }
    },
    "owner": "sudeep018"
  }
}
